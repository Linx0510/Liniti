<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Заявки на вывод | Админ-панель LineStok</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('../partials/header-actions') %>
        <section class="admin-container">
            <%- include('admin-sidebar', { currentPath: '/admin/withdrawals' }) %>
            <div class="admin-main">
                <div class="admin-header">
                    <h1>Заявки на вывод</h1>
                </div>
                <section class="content-card withdrawals-card">
                <div class="filter-tabs">
                    <button class="filter-tab active" data-filter="all">Все</button>
                    <button class="filter-tab" data-filter="pending">На рассмотрении</button>
                    <button class="filter-tab" data-filter="approved">Выполнены</button>
                    <button class="filter-tab" data-filter="rejected">Отклонены</button>
                </div>
                <div class="table-scroll">
                <table class="withdraw-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Пользователь</th>
                            <th>Сумма</th>
                            <th>Способ</th>
                            <th>Реквизиты</th>
                            <th>Банк</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody id="withdrawTableBody">
                        <tr><td colspan="9" class="empty-state">Загрузка...</td></tr>
                    </tbody>
                </table>
                </div>
                </section>
            </div>
        </section>
    </main>
    <script>
        const csrfToken = '<%= csrfToken %>';
        const withdrawalStatusLabels = <%- JSON.stringify(STATUS_LABELS_BY_CONTEXT.withdrawal) %>;
        let allWithdrawals = [];

        async function loadWithdrawals() {
            try {
                const res = await fetch('/api/admin/withdrawals');
                const data = await res.json();
                allWithdrawals = data.withdrawals || [];
                render('all');
            } catch (err) {
                document.getElementById('withdrawTableBody').innerHTML = '<tr><td colspan="9" class="empty-state">Ошибка загрузки</td></tr>';
            }
        }

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, (char) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[char]));
        }

        function parsePayoutError(error) {
            if (!error) return '';
            try {
                const parsed = JSON.parse(error);
                return parsed.description || error;
            } catch (e) {
                return error;
            }
        }

        function methodLabel(m) {
            return m === 'card' ? 'Карта' : (m === 'sbp' ? 'СБП' : 'ЮMoney');
        }

        function render(filter) {
            const tbody = document.getElementById('withdrawTableBody');
            const rows = filter === 'all' ? allWithdrawals : allWithdrawals.filter(w => w.status === filter);
            if (rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="empty-state">Нет заявок</td></tr>';
                return;
            }
            tbody.innerHTML = rows.map(w => {
                const statusClass = w.status;
                const statusText = withdrawalStatusLabels[w.status] || 'Не указан';
                const payoutError = w.payout_error ? `<div class="payout-error">${escapeHtml(parsePayoutError(w.payout_error))}</div>` : '';
                const actions = w.status === 'pending' ? `
                    <div class="withdraw-actions">
                        <button class="btn-sm btn-approve" onclick="approve(${w.id})">Подтвердить</button>
                        <input type="text" class="reject-input" id="reject-reason-${w.id}" placeholder="Причина отклонения">
                        <button class="btn-sm btn-reject" onclick="reject(${w.id})">Отклонить</button>
                    </div>
                ` : (w.rejection_reason ? `<span class="rejection-reason">${escapeHtml(w.rejection_reason)}</span>` : '—');
                return `
                    <tr data-status="${w.status}">
                        <td>#${w.id}</td>
                        <td>${escapeHtml(w.first_name || '')} ${escapeHtml(w.last_name || '')}<br><small>${escapeHtml(w.email)}</small></td>
                        <td><strong>${Number(w.amount).toLocaleString('ru-RU')} ₽</strong></td>
                        <td>${escapeHtml(methodLabel(w.payment_method))}</td>
                        <td>${escapeHtml(w.details)}</td>
                        <td>${w.bank_id ? `<small>${escapeHtml(w.bank_id)}</small>` : '—'}</td>
                        <td><span class="withdraw-status ${statusClass}">${statusText}</span>${payoutError}</td>
                        <td>${new Date(w.created_at).toLocaleDateString('ru-RU')}<br><small>${new Date(w.created_at).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'})}</small></td>
                        <td>${actions}</td>
                    </tr>
                `;
            }).join('');
        }

        async function approve(id) {
            if (!await confirmModalPromise('Подтвердить вывод средств?', { confirmText: 'Подтвердить' })) return;
            try {
                const res = await fetch(`/api/admin/withdrawals/${id}/approve`, {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': csrfToken }
                });
                const data = await res.json();
                if (data.success) {
                    loadWithdrawals();
                } else {
                    showAlert(data.error || 'Ошибка', { danger: true });
                }
            } catch (err) {
                showAlert('Ошибка сети', { danger: true });
            }
        }

        async function reject(id) {
            const reason = document.getElementById(`reject-reason-${id}`)?.value.trim();
            if (!reason) {
                showAlert('Укажите причину отклонения', { title: 'Нужна причина' });
                return;
            }
            if (!await confirmModalPromise('Отклонить заявку? Средства будут возвращены пользователю.', { confirmText: 'Отклонить', danger: true })) return;
            try {
                const res = await fetch(`/api/admin/withdrawals/${id}/reject`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ reason })
                });
                const data = await res.json();
                if (data.success) {
                    loadWithdrawals();
                } else {
                    showAlert(data.error || 'Ошибка', { danger: true });
                }
            } catch (err) {
                showAlert('Ошибка сети', { danger: true });
            }
        }

        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                render(tab.dataset.filter);
            });
        });

        loadWithdrawals();
    </script>
    <%- include('../partials/confirm-modal') %>
    <script src="/js/admin.js"></script>
</body>
</html>
