<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Услуги | LineStok</title>
    <link rel="stylesheet" href="/css/services.css">
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('partials/header-actions') %>

        <div class="services-page">
            <section class="services-section settings-section">
                <div class="services-heading">
                    <h1>Услуги</h1>
                    <a class="primary-btn services-create-btn" href="/services/create">Создать услугу</a>
                </div>

                <% const safeAllServices = Array.isArray(allServices) ? allServices : []; %>

                <% if (!safeAllServices.length) { %>
                    <div class="services-empty">Пока нет опубликованных услуг.</div>
                <% } else { %>
                    <div class="services-grid">
                        <% safeAllServices.forEach((service) => {
                            const image = service.cover_image || service.cover || '/img/ab934e72b62ae5df2cfc9b2102b0e228.jpg';
                            const minPrice = Number(service.price_from ?? service.price ?? 0);
                        %>
                            <article class="service-card">
                                <div class="service-card-image-wrap">
                                    <img class="service-card-image" src="<%= image %>" alt="<%= service.title || 'Услуга' %>">
                                </div>
                                <div class="service-card-content">
                                    <h2 class="service-card-title"><%= service.title || 'Без названия' %></h2>
                                    <p class="service-card-price">ОТ <%= minPrice.toLocaleString('ru-RU') %> ₽</p>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
</body>
</html>
