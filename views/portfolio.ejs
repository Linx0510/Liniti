<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Моё портфолио | LineStok</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/portfolio.css">
</head>
<body>
  <main>
    <%- include('partials/header-actions') %>

    <section class="portfolio-page">
      <div class="portfolio-head">
        <h1>Моё портфолио</h1>
        <p>Отдельная страница портфолио с управлением вашими работами.</p>
        <div class="portfolio-actions">
          <a href="/works/create" class="btn-primary">Добавить работу</a>
          <a href="/profile" class="btn-secondary">Открыть профиль</a>
        </div>
      </div>

      <% if (pendingWorks && pendingWorks.length) { %>
        <section class="portfolio-block">
          <h2>На модерации (<%= pendingWorks.length %>)</h2>
          <ul class="pending-list">
            <% pendingWorks.forEach((work) => { %>
              <li>
                <strong><%= work.title %></strong>
                <span><%= new Date(work.created_at).toLocaleDateString('ru-RU') %></span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <section class="portfolio-block">
        <h2>Опубликованные работы (<%= activeWorks.length %>)</h2>
        <% if (!activeWorks.length) { %>
          <p class="empty-state">У вас пока нет опубликованных работ.</p>
        <% } %>
        <div class="works-grid">
          <% activeWorks.forEach((work) => { %>
            <% const preview = (work.images && work.images[0]) ? work.images[0] : '/img/work_img.svg'; %>
            <article class="work-card">
              <img src="<%= preview %>" alt="<%= work.title %>" onerror="this.onerror=null;this.src='/img/work_img.svg';">
              <div class="work-card__content">
                <h3><%= work.title %></h3>
                <div class="work-card__actions">
                  <a href="/works/<%= work.id %>">Открыть</a>
                  <a href="/works/<%= work.id %>/edit">Редактировать</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    </section>
  </main>
</body>
</html>
