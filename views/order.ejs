<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= order.title || 'Сделка' %> | LineStok</title>
    <link rel="stylesheet" href="/css/services.css">
    <link rel="stylesheet" href="/css/confirm-modal.css">
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('partials/header-actions') %>
        <div class="orders-layout order-detail-layout">
                <div class="service-main">
                    <div class="service-details">
                        <h1 class="service-title"><%= order.title || 'Без названия' %></h1>

                        <% if (order.description) { %>
                            <p class="service-lead"><%= order.description %></p>
                        <% } %>

                        <% if (files && files.length) { %>
                            <div class="order-files" style="margin-top: 18px;">
                                <h3 style="font-size: 15px; margin-bottom: 10px; color: #333;">Прикреплённые файлы</h3>
                                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                    <% files.forEach(file => { %>
                                        <a href="<%= file.file_url %>" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px; background: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 8px; padding: 8px 12px; font-size: 13px; color: #333; text-decoration: none;">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.25 2.5C14.25 2.36193 14.1381 2.25 14 2.25H7C5.48122 2.25 4.25 3.48122 4.25 5V19C4.25 20.5188 5.48122 21.75 7 21.75H17C18.5188 21.75 19.75 20.5188 19.75 19V9.14706C19.75 9.00899 19.6381 8.89706 19.5 8.89706H15C14.5858 8.89706 14.25 8.56127 14.25 8.14706V2.5Z" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            <%= file.original_name || 'Файл' %>
                                        </a>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <div class="service-meta">
                            <div class="service-meta-item">
                                <span class="service-meta-label">Стоимость</span>
                                <span class="service-meta-value"><%= Number(order.price || 0).toLocaleString('ru-RU') %> ₽</span>
                            </div>
                            <div class="service-meta-item">
                                <span class="service-meta-label">Статус</span>
                                <span class="service-meta-value">
                                    <span class="order-status status-<%= order.status %>">
                                        <%= order.status === 'active' ? 'Активна' : (order.status === 'in_progress' ? 'В работе' : (order.status === 'completed' ? 'Выполнена' : 'Отменена')) %>
                                    </span>
                                </span>
                            </div>
                            <% if (order.payment_status) { %>
                                <div class="service-meta-item">
                                    <span class="service-meta-label">Оплата</span>
                                    <span class="service-meta-value">
                                        <% if (order.payment_status === 'held') { %>
                                            <span style="color:#2e7d32;">Оплачено и заморожено</span>
                                        <% } else if (order.payment_status === 'released') { %>
                                            <span style="color:#2e7d32;">Выплачено исполнителю</span>
                                        <% } else if (order.payment_status === 'cancelled') { %>
                                            <span style="color:#c62828;">Возвращено заказчику</span>
                                        <% } else { %>
                                            <span style="color:#888;">Ожидает оплаты</span>
                                        <% } %>
                                    </span>
                                </div>
                            <% } %>
                            <% if (order.deadline) { %>
                                <div class="service-meta-item">
                                    <span class="service-meta-label">Дедлайн</span>
                                    <span class="service-meta-value"><%= new Date(order.deadline).toLocaleDateString('ru-RU') %></span>
                                </div>
                            <% } %>
                            <div class="service-meta-item">
                                <span class="service-meta-label">Создана</span>
                                <span class="service-meta-value"><%= new Date(order.created_at).toLocaleDateString('ru-RU') %></span>
                            </div>
                            <% if (order.completed_at) { %>
                                <div class="service-meta-item">
                                    <span class="service-meta-label">Завершена</span>
                                    <span class="service-meta-value"><%= new Date(order.completed_at).toLocaleDateString('ru-RU') %></span>
                                </div>
                            <% } %>
                        </div>

                        <% if (stages && stages.length) { %>
                            <div class="order-stages">
                                <h3>Этапы</h3>
                                <div class="stages-list">
                                    <% stages.forEach(stage => { %>
                                        <div class="stage-item <%= stage.completed ? 'stage-completed' : '' %>" data-stage-id="<%= stage.id %>">
                                            <span class="stage-check" style="cursor: <%= isExecutor && order.status === 'in_progress' ? 'pointer' : 'default' %>;"><%= stage.completed ? '✓' : '○' %></span>
                                            <span class="stage-name"><%= stage.name %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="service-sidebar">
                    <div class="service-provider-card">
                        <img src="<%= order.customer_avatar || '/img/Group.svg' %>" alt="" class="service-provider-avatar">
                        <div class="service-provider-info">
                            <h2><%= order.customer_first_name || '' %> <%= order.customer_last_name || '' %></h2>
                            <p>Заказчик</p>
                        </div>
                        <a href="/profile/<%= order.customer_id %>" class="service-provider-link">Профиль заказчика</a>
                    </div>

                    <% if (order.executor_id) { %>
                    <div class="service-provider-card">
                        <img src="<%= order.executor_avatar || '/img/Group.svg' %>" alt="" class="service-provider-avatar">
                        <div class="service-provider-info">
                            <h2><%= order.executor_first_name || '' %> <%= order.executor_last_name || '' %></h2>
                            <p>Исполнитель</p>
                        </div>
                        <a href="/profile/<%= order.executor_id %>" class="service-provider-link">Профиль исполнителя</a>
                    </div>
                    <% } %>

                    <div class="service-order-card">
                        <% if (order.status === 'active') { %>
                            <% if (isExecutor) { %>
                                <button class="service-order-btn" id="acceptOrderBtn" data-id="<%= order.id %>">Принять сделку</button>
                            <% } else if (isCustomer) { %>
                                <button class="cancel-order-btn service-archive-btn" id="cancelOrderBtn" data-id="<%= order.id %>">Отменить сделку</button>
                            <% } else { %>
                                <a href="/deals/propose?targetType=order&targetId=<%= order.id %>" class="service-order-btn">Предложить сделку</a>
                            <% } %>
                        <% } else if (order.status === 'in_progress') { %>
                            <% if (isCustomer) { %>
                                <% if (order.customer_confirmed) { %>
                                    <span class="service-order-price-value" style="color:#2e7d32;">✓ Вы подтвердили выполнение</span>
                                <% } else { %>
                                    <button class="service-order-btn" id="completeOrderBtn" data-id="<%= order.id %>">Подтвердить выполнение</button>
                                <% } %>
                                <button class="cancel-order-btn service-archive-btn" id="cancelOrderBtn" data-id="<%= order.id %>">Отменить</button>
                            <% } else if (isExecutor) { %>
                                <% if (order.executor_confirmed) { %>
                                    <span class="service-order-price-value" style="color:#2e7d32;">✓ Вы подтвердили сдачу</span>
                                <% } else { %>
                                    <button class="service-order-btn" id="deliverOrderBtn" data-id="<%= order.id %>">Сдать работу</button>
                                <% } %>
                                <button class="cancel-order-btn service-archive-btn" id="cancelOrderBtn" data-id="<%= order.id %>">Отменить</button>
                            <% } %>
                            <% if (order.customer_confirmed || order.executor_confirmed) { %>
                                <div style="margin-top:10px;font-size:13px;color:#666;">
                                    <% if (order.customer_confirmed) { %><div>Заказчик подтвердил</div><% } %>
                                    <% if (order.executor_confirmed) { %><div>Исполнитель подтвердил</div><% } %>
                                </div>
                            <% } %>
                        <% } else if (order.status === 'completed') { %>
                            <span class="service-order-price-value">Сделка завершена</span>
                            <% if (order.fee_amount > 0) { %>
                                <div style="font-size:12px;color:#888;margin-top:4px;">Комиссия платформы: <%= Number(order.fee_amount).toLocaleString('ru-RU') %> ₽</div>
                            <% } %>
                        <% } else if (order.status === 'cancelled') { %>
                            <span class="service-order-price-value">Сделка отменена</span>
                        <% } %>
                    </div>

                    <div class="service-order-card">
                        <a href="<%= chatUserId ? '/chat?user=' + chatUserId : '/chat' %>" class="service-order-btn">Перейти в чат</a>
                    </div>
                </div>
        </div>
    </main>
    <%- include('partials/confirm-modal') %>
    <script>
        function showConfirm(message, onConfirm, options = {}) {
            const modal = document.getElementById('confirmModal');
            const titleEl = document.getElementById('confirmModalTitle');
            const msgEl = document.getElementById('confirmModalMessage');
            const okBtn = document.getElementById('confirmModalOk');
            const cancelBtn = document.getElementById('confirmModalCancel');
            titleEl.textContent = options.title || 'Подтвердите действие';
            msgEl.textContent = message;
            okBtn.textContent = options.confirmText || 'Подтвердить';
            cancelBtn.style.display = options.hideCancel ? 'none' : 'inline-block';
            modal.style.display = 'flex';
            const cleanup = () => { modal.style.display = 'none'; okBtn.onclick = null; };
            okBtn.onclick = () => { cleanup(); onConfirm(); };
            cancelBtn.onclick = cleanup;
        }
        function closeConfirm() {
            document.getElementById('confirmModal').style.display = 'none';
        }
        function showAlert(message) {
            showConfirm(message, () => {}, { title: 'Внимание', confirmText: 'OK', hideCancel: true });
        }

        const csrfToken = '<%= csrfToken %>';

        async function apiPost(url) {
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': csrfToken }
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    showAlert(data.error || 'Ошибка');
                }
            } catch (err) {
                showAlert('Ошибка сети');
            }
        }

        document.getElementById('acceptOrderBtn')?.addEventListener('click', function() {
            apiPost(`/api/orders/${this.dataset.id}/accept`);
        });
        document.getElementById('completeOrderBtn')?.addEventListener('click', function() {
            showConfirm('Подтвердить выполнение сделки?', () => apiPost(`/api/orders/${this.dataset.id}/complete`));
        });
        document.getElementById('deliverOrderBtn')?.addEventListener('click', function() {
            showConfirm('Подтвердить сдачу работы?', () => apiPost(`/api/orders/${this.dataset.id}/deliver`));
        });
        document.getElementById('cancelOrderBtn')?.addEventListener('click', function() {
            showConfirm('Отменить сделку?', () => apiPost(`/api/orders/${this.dataset.id}/cancel`));
        });

        <% if (isExecutor && order.status === 'in_progress') { %>
        document.querySelectorAll('.stage-check').forEach(el => {
            el.addEventListener('click', async function() {
                const stageItem = this.closest('.stage-item');
                const stageId = stageItem?.dataset.stageId;
                if (!stageId) return;
                try {
                    const res = await fetch(`/api/orders/<%= order.id %>/stages/${stageId}/toggle`, {
                        method: 'POST',
                        headers: { 'X-CSRF-Token': csrfToken }
                    });
                    const data = await res.json();
                    if (data.success) {
                        stageItem.classList.toggle('stage-completed', data.stage.completed);
                        this.textContent = data.stage.completed ? '✓' : '○';
                    } else {
                        showAlert(data.error || 'Ошибка');
                    }
                } catch (err) {
                    showAlert('Ошибка сети');
                }
            });
        });
        <% } %>
    </script>
</body>
</html>
