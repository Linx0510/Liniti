<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Биржа | LineStok</title>
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('partials/header-actions') %>
        <section class="role-switch-section" style="padding: 24px;">
            <h1 style="margin-bottom: 16px;">Биржа</h1>
            <div class="switch">
                <input type="radio" name="userType" id="freelance" checked>
                <input type="radio" name="userType" id="customer">
                <div class="active-bg"></div>
                <label for="freelance">Я исполнитель</label>
                <label for="customer">Я заказчик</label>
            </div>
        </section>
    </main>
</body>
</html>
